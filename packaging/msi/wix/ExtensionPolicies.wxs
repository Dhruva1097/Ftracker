<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <ComponentGroup Id="ExtensionComponents" Directory="EXTDIR">
      <Component Id="ExtManifest" Guid="{C7D8E9F0-0123-4345-D263-7E8F90123456}" Win64="$(var.Win64)">
        <File Id="ExtManifestFile" Source="!(bindpath.ext)\manifest.json" KeyPath="yes" />
      </Component>
      <Component Id="ExtBackground" Guid="{D8E9F012-1234-4456-E374-8F9012345678}" Win64="$(var.Win64)">
        <File Id="ExtBackgroundFile" Source="!(bindpath.ext)\background.js" KeyPath="yes" />
      </Component>
      <Component Id="ExtContent" Guid="{E9F01234-2345-4567-F485-90123456789A}" Win64="$(var.Win64)">
        <File Id="ExtContentFile" Source="!(bindpath.ext)\content.js" KeyPath="yes" />
      </Component>
      <Component Id="NativeHost" Guid="{F0123456-3456-4678-A596-0123456789AB}" Directory="INSTALLDIR" Win64="$(var.Win64)">
        <File Id="NativeHostJson" Source="!(bindpath.nmh)\com.ftracker.host.json" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Google\Chrome\NativeMessagingHosts\com.ftracker.host" Type="string" Value="[INSTALLDIR]com.ftracker.host.json" />
        <RegistryValue Root="HKLM" Key="Software\Policies\Google\Chrome\ExtensionInstallForcelist" Name="1" Type="string" Value="abcdefghijklmnopqrstuvwxyzabcdef;file:///C:/Program Files/Ftracker/extension/manifest.json" />
      </Component>
      <Component Id="EdgePolicies" Guid="{01234567-4567-4789-B6A7-123456789ABC}" Win64="$(var.Win64)">
        <Condition><![CDATA[VersionNT >= 602]]></Condition>
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Edge\NativeMessagingHosts\com.ftracker.host" Type="string" Value="[INSTALLDIR]com.ftracker.host.json" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Policies\Microsoft\Edge\ExtensionInstallForcelist" Name="1" Type="string" Value="abcdefghijklmnopqrstuvwxyzabcdef" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
