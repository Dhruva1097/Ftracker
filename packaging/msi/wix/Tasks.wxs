<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?include $(sys.SOURCEFILEDIR)Config.wxi ?>
  <Fragment>
    <ComponentGroup Id="TaskComponents" Directory="INSTALLDIR">
      <Component Id="LogonTaskXml" Guid="{A5B6C7D8-E9F0-4123-B041-5C6D7E8F9012}" Win64="$(var.Win64)">
        <File Id="LogonXml" Source="!(bindpath.tasks)\FtrackerLogon.xml" KeyPath="yes" />
      </Component>
      <Component Id="EnsureTaskXml" Guid="{B6C7D8E9-F012-4234-C152-6D7E8F901234}" Win64="$(var.Win64)">
        <File Id="EnsureXml" Source="!(bindpath.tasks)\FtrackerEnsure.xml" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
