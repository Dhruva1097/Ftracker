<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?include $(sys.SOURCEFILEDIR)Config.wxi ?>
  <Fragment>
    <Binary Id="ErrorIco" SourceFile="$(sys.SOURCEFILEDIR)..\..\res\ftracker.ico" />
    <UI Id="FtrackerUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="ErrorDialog" Value="ErrorDlg" />
      <Dialog Id="ConsentDlg" Width="480" Height="340" Title="Ftracker consent">
        <Control Id="Title" Type="Text" X="15" Y="10" Width="450" Height="24" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Work tracking terms - scroll and read all" />
        <Control Id="Body" Type="ScrollableText" X="15" Y="36" Width="450" Height="268" Sunken="yes" TabSkip="no">
          <Text SourceFile="$(sys.SOURCEFILEDIR)consent.rtf" />
        </Control>
        <Control Id="Next" Type="PushButton" X="348" Y="313" Width="56" Height="17" Default="yes" Text="&amp;Accept">
          <Condition Action="enable">1</Condition>
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="408" Y="313" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit">1</Publish>
        </Control>
      </Dialog>
      <!-- PushButtons must form a Control_Next cycle. A modeless ProgressDlg with only Text
           controls left Control_Next empty and raised MSI 2814 when the dialog was shown. -->
      <Dialog Id="ProgressDlg" Width="370" Height="270" Title="Ftracker Setup" Modeless="yes">
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="Back" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Disabled="yes" Text="Next" />
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="30" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Installing Ftracker" />
        <Control Id="Text" Type="Text" X="20" Y="60" Width="330" Height="30" Transparent="yes" NoPrefix="yes" Text="Please wait. Do not cancel unless Setup is stuck." />
        <Control Id="Status" Type="Text" X="20" Y="100" Width="330" Height="20" Transparent="yes" NoPrefix="yes">
          <Subscribe Event="ActionText" Attribute="Text" />
        </Control>
        <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="140" Width="330" Height="16" ProgressBlocks="yes" Text="Progress">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
      </Dialog>
      <Dialog Id="CancelDlg" Width="260" Height="85" Title="Ftracker Setup">
        <Control Id="No" Type="PushButton" X="132" Y="57" Width="56" Height="17" Default="yes" Cancel="yes" Text="&amp;No">
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
        <Control Id="Yes" Type="PushButton" X="72" Y="57" Width="56" Height="17" Text="&amp;Yes">
          <Publish Event="EndDialog" Value="Exit">1</Publish>
        </Control>
        <Control Id="Text" Type="Text" X="15" Y="15" Width="230" Height="30" Text="Cancel Ftracker Setup?" />
      </Dialog>
      <!-- Error buttons must not be in Control_Next. MSI 2814 was ErrorDlg/ErrorText/Y. -->
      <Dialog Id="ErrorDlg" Width="270" Height="105" Title="Ftracker Setup" ErrorDialog="yes">
        <Control Id="ErrorText" Type="Text" X="48" Y="15" Width="205" Height="60" TabSkip="no" NoPrefix="yes" Text="Info">
          <Subscribe Event="ErrorText" Attribute="Text" />
        </Control>
        <Control Id="Y" Type="PushButton" X="100" Y="80" Width="56" Height="17" Hidden="yes" TabSkip="yes" Text="&amp;Yes">
          <Publish Event="EndDialog" Value="ErrorYes">1</Publish>
        </Control>
        <Control Id="A" Type="PushButton" X="100" Y="80" Width="56" Height="17" Hidden="yes" TabSkip="yes" Text="&amp;Abort">
          <Publish Event="EndDialog" Value="ErrorAbort">1</Publish>
        </Control>
        <Control Id="C" Type="PushButton" X="100" Y="80" Width="56" Height="17" Hidden="yes" TabSkip="yes" Text="&amp;Cancel">
          <Publish Event="EndDialog" Value="ErrorCancel">1</Publish>
        </Control>
        <Control Id="I" Type="PushButton" X="100" Y="80" Width="56" Height="17" Hidden="yes" TabSkip="yes" Text="&amp;Ignore">
          <Publish Event="EndDialog" Value="ErrorIgnore">1</Publish>
        </Control>
        <Control Id="N" Type="PushButton" X="100" Y="80" Width="56" Height="17" Hidden="yes" TabSkip="yes" Text="&amp;No">
          <Publish Event="EndDialog" Value="ErrorNo">1</Publish>
        </Control>
        <Control Id="O" Type="PushButton" X="100" Y="80" Width="56" Height="17" Hidden="yes" TabSkip="yes" Text="OK">
          <Publish Event="EndDialog" Value="ErrorOk">1</Publish>
        </Control>
        <Control Id="R" Type="PushButton" X="100" Y="80" Width="56" Height="17" Hidden="yes" TabSkip="yes" Text="&amp;Retry">
          <Publish Event="EndDialog" Value="ErrorRetry">1</Publish>
        </Control>
        <Control Id="ErrorIcon" Type="Icon" X="15" Y="15" Width="24" Height="24" FixedSize="yes" IconSize="32" TabSkip="no" Text="ErrorIco" />
      </Dialog>
      <Dialog Id="FilesInUse" Width="370" Height="270" Title="Ftracker Setup">
        <Control Id="Retry" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Retry">
          <Publish Event="EndDialog" Value="Retry">1</Publish>
        </Control>
        <Control Id="Ignore" Type="PushButton" X="242" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Ignore">
          <Publish Event="EndDialog" Value="Ignore">1</Publish>
        </Control>
        <Control Id="Exit" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="E&amp;xit">
          <Publish Event="EndDialog" Value="Exit">1</Publish>
        </Control>
        <Control Id="Banner" Type="Text" X="15" Y="15" Width="340" Height="30" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Files in Use" />
        <Control Id="Text" Type="Text" X="20" Y="50" Width="330" Height="30" Text="Ftracker is still running. Setup will replace it. Click Ignore to continue." />
        <Control Id="List" Type="ListBox" X="20" Y="87" Width="330" Height="140" Property="FileInUseProcess" Sunken="yes" TabSkip="yes">
          <ListBox Property="FileInUseProcess">
            <ListItem Text=" " Value="0" />
          </ListBox>
          <Subscribe Event="FileInUse" Attribute="Text" />
        </Control>
      </Dialog>
      <Dialog Id="FatalError" Width="370" Height="270" Title="Ftracker Setup">
        <Control Id="Finish" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="Finish">
          <Publish Event="EndDialog" Value="Exit">1</Publish>
        </Control>
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="30" Transparent="yes" NoPrefix="yes" TabSkip="no" Text="{\WixUI_Font_Title}Setup ended prematurely" />
        <Control Id="Text" Type="Text" X="20" Y="60" Width="330" Height="80" Text="Ftracker Setup ended because of an error." />
      </Dialog>
      <Dialog Id="UserExit" Width="370" Height="270" Title="Ftracker Setup">
        <Control Id="Finish" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="Finish">
          <Publish Event="EndDialog" Value="Exit">1</Publish>
        </Control>
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="30" Transparent="yes" NoPrefix="yes" TabSkip="no" Text="{\WixUI_Font_Title}Setup canceled" />
        <Control Id="Text" Type="Text" X="20" Y="60" Width="330" Height="80" Text="Ftracker Setup was canceled." />
      </Dialog>
      <Dialog Id="ExitDialog" Width="370" Height="270" Title="Ftracker Setup">
        <Control Id="Finish" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="Finish">
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="30" Transparent="yes" NoPrefix="yes" TabSkip="no" Text="{\WixUI_Font_Title}Setup complete" />
        <Control Id="Text" Type="Text" X="20" Y="60" Width="330" Height="80" Text="Ftracker is installed. Click Finish." />
      </Dialog>
      <InstallUISequence>
        <Show Dialog="FatalError" OnExit="error" />
        <Show Dialog="UserExit" OnExit="cancel" />
        <Show Dialog="ExitDialog" OnExit="success" />
        <Show Dialog="ConsentDlg" After="CostFinalize">NOT Installed AND NOT PREASSIGNED</Show>
        <Show Dialog="ProgressDlg" Before="ExecuteAction" />
        <ExecuteAction Sequence="1300" />
      </InstallUISequence>
      <AdminUISequence>
        <Show Dialog="FatalError" OnExit="error" />
        <Show Dialog="UserExit" OnExit="cancel" />
        <Show Dialog="ExitDialog" OnExit="success" />
        <ExecuteAction Sequence="1300" />
      </AdminUISequence>
    </UI>
  </Fragment>
</Wix>
