<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?include $(sys.SOURCEFILEDIR)Config.wxi ?>
  <Fragment>
    <UI Id="FtrackerUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Dialog Id="ConsentDlg" Width="370" Height="270" Title="Ftracker consent">
        <Control Id="Title" Type="Text" X="15" Y="10" Width="340" Height="30" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Work tracking consent" />
        <Control Id="Body" Type="ScrollableText" X="15" Y="45" Width="340" Height="160" Sunken="yes">
          <Text>This PC records active time, app titles, and location; blocks USB storage; cancels Chrome/Edge uploads over 100MB until an admin authenticator code; autostarts; sends a daily PDF work report. Local files are not deleted. The work screen is sampled while you are active (compressed pictures go only to the admin PDF, not to the employee). Idle and lock screens are not captured.</Text>
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Accept">
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit">1</Publish>
        </Control>
      </Dialog>
      <InstallUISequence>
        <Show Dialog="ConsentDlg" After="CostFinalize">NOT Installed AND NOT PREASSIGNED</Show>
        <ExecuteAction Sequence="1300" />
      </InstallUISequence>
      <AdminUISequence>
        <ExecuteAction Sequence="1300" />
      </AdminUISequence>
    </UI>
  </Fragment>
</Wix>
