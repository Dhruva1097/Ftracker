<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?include $(sys.SOURCEFILEDIR)Config.wxi ?>
  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLDIR">
      <Component Id="FtrackerExeComp" Guid="{C1D2E3F4-A5B6-4789-9C0D-1E2F3A4B5C6D}" Win64="$(var.Win64)">
        <File Id="FtrackerExe" Source="!(bindpath.bin)\ftracker.exe" KeyPath="yes" />
        <File Id="RehashFlag" Source="!(bindpath.pre)\rehash.flag" Name="rehash.flag" CompanionFile="FtrackerExe" />
        <ServiceInstall Id="FtrackerSvcInstall" Name="FtrackerSvc" DisplayName="Ftracker USB and integrity service"
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem"
                        Arguments="--service" />
        <ServiceControl Id="FtrackerSvcControl" Name="FtrackerSvc" Start="install" Stop="both" Remove="uninstall" Wait="no" />
        <RegistryKey Root="HKLM" Key="Software\Ftracker">
          <RegistryValue Name="ProductCode" Type="string" Value="[ProductCode]" />
          <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLDIR]" />
        </RegistryKey>
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="Ftracker" Type="string" Value="&quot;[INSTALLDIR]ftracker.exe&quot;" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Ftracker" Name="UninstallString" Type="string" Value="&quot;[INSTALLDIR]ftracker.exe&quot; --uninstall" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Ftracker" Name="DisplayName" Type="string" Value="Ftracker" />
      </Component>
      <Component Id="IconComp" Guid="{E3F4A5B6-C7D8-4901-BE2F-3A4B5C6D7E8F}" Win64="$(var.Win64)">
        <File Id="FtrackerIco" Source="!(bindpath.res)\ftracker.ico" KeyPath="yes" />
      </Component>
    </ComponentGroup>
    <?ifdef Preassigned ?>
    <ComponentGroup Id="PreassignComponents" Directory="INSTALLDIR">
      <Component Id="PreassignJson" Guid="{A1B2C3D4-E5F6-4789-8A90-B1C2D3E4F5A6}" Win64="$(var.Win64)">
        <File Id="PreassignFile" Source="!(bindpath.pre)\preassign.json" KeyPath="yes" />
      </Component>
    </ComponentGroup>
    <?endif ?>
  </Fragment>
</Wix>
