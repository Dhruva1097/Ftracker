<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Fragment>
    <ComponentGroup Id="ServiceComponents" Directory="INSTALLDIR">
      <Component Id="FtrackerServiceInstall" Guid="{F4A5B6C7-D8E9-4012-AF30-4B5C6D7E8F90}" Win64="$(var.Win64)">
        <File Id="FtrackerSvcForService" Source="!(bindpath.bin)\ftracker-svc.exe" KeyPath="yes" />
        <ServiceInstall Id="FtrackerSvcInstall" Name="FtrackerSvc" DisplayName="Ftracker USB and integrity service"
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem">
          <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart"
                              ThirdFailureActionType="restart" RestartServiceDelayInSeconds="60" ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="FtrackerSvcControl" Name="FtrackerSvc" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
